# .env.example

# Database
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=your_password_here
MARIADB_DATABASE=whatsapp_db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_characters_long_here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp
WHATSAPP_SESSION_PATH=./sessions

# App Config
NODE_ENV=development
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=500
MAX_DEVICES_PER_USER=10
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

# Cron
CRON_SECRET=your_nextauth_secret_min_32_characters_long_here
