NODE_ENV=production

MARIADB_HOST=your-production-db-host
MARIADB_PORT=3306
MARIADB_USER=your-db-user
MARIADB_PASSWORD=your-secure-db-password
MARIADB_DATABASE=whatsapp_production
DB_CONNECTION_LIMIT=50
DB_IDLE_TIMEOUT_MS=60000

NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your-super-secret-nextauth-key-at-least-32-characters-long
PASSWORD_PEPPER=your-additional-password-pepper-secret-key-here

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

API_KEY_SECRET=your-api-key-hmac-secret-for-hashing

REDIS_URL=redis://your-redis-host:6379
REDIS_PASSWORD=your-redis-password

ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=50000

MAX_RETRY_ATTEMPTS=5
RETRY_DELAY_MS=3000

CRON_SECRET=your-cron-secret-token-minimum-16-characters

LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true

MAX_UPLOAD_SIZE_MB=25
STORAGE_CLEANUP_DAYS=90

WEBHOOK_TIMEOUT_MS=15000
WEBHOOK_MAX_RETRIES=5

SESSION_TIMEOUT_MS=3600000

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=WhatsApp Dashboard <noreply@yourdomain.com>

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_SENTRY=true

WHATSAPP_SESSION_PATH=./sessions

ENABLE_FILE_ENCRYPTION=true
FILE_ENCRYPTION_KEY=your-32-byte-encryption-key-for-files

MAX_CONCURRENT_CLIENTS=100
CLIENT_HEALTH_CHECK_INTERVAL=30000